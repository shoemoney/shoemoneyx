APP_NAME=shoemoneyx
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_PREFIX=shoemoneyx-
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- shoemoneyx desk -------------------------------------------------------
DESK_MODE=paper                # paper | live
DESK_STRATEGY=mr               # mr | custom
DESK_PAPER_CASH=1000
DESK_MAX_PRODUCTS=60           # universe size scanned per cycle
DESK_MIN_VOLUME_24H=250000
DESK_TAKER_FEE=0.006
DESK_LOCKED_PCT=0.20
MASTER_PASSWORD=               # optional: one password gating every page + the API (X-Desk-Token header or ?token=)
DESK_LIVE_CONFIRM=no           # must be "yes" before a live order can be sent
DESK_USE_SCHEDULER=false       # true = drive with `schedule:work` instead of `desk:run`

# Coinbase Advanced Trade (CDP key). Only needed for live mode / balances.
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=

# Telegram end-of-day + alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional local WorldMonitor instance for context (blank = off)
WORLDMONITOR_URL=

# Community hub (shoemoneyx-hub). Public reads work with no connection at all.
HUB_URL=

# Reverb (websocket firehose for the dashboard). BROADCAST_CONNECTION=reverb to enable; log = off.
REVERB_APP_ID=shoemoneyx
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8812
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8812
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Public showcase only. Blocks all mutations and serves synthetic API data.
SITE_DEMO=false

FARM_HOSTS='{}'
FARM_CONNECTIONS_PER_WORKER=2
FARM_EXPECTED_WORKERS='{"default": 4}'
