[Unit]
Description=shoemoneyx desk trading loop (desk:run)
After=network-online.target mariadb.service redis-server.service shoemoneyx-first-boot.service
Requires=shoemoneyx-first-boot.service
Wants=network-online.target

[Service]
Type=simple
User=shoemoneyx
Group=shoemoneyx
WorkingDirectory=/opt/shoemoneyx
ExecStart=/usr/bin/php artisan desk:run
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
