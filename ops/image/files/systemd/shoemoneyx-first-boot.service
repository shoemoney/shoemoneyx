[Unit]
Description=shoemoneyx desk first-boot setup (pin version, bring up the stack via docker/up.sh, write credentials)
After=docker.service network-online.target
Wants=docker.service network-online.target
ConditionPathExists=!/opt/shoemoneyx/.env
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/shoemoneyx-first-boot.sh
# Idempotent: docker/up.sh no-ops on an existing .env, and the ConditionPathExists above skips
# this unit entirely once .env exists, so a retry on failure (DB/registry not quite up yet) is
# safe and a reboot never repeats secret generation. The containers themselves come back on
# reboot via their own restart:unless-stopped, not this unit.
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
