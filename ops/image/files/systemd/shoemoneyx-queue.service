[Unit]
Description=shoemoneyx desk queue worker (queue:work)
After=network-online.target mariadb.service redis-server.service shoemoneyx-first-boot.service
Requires=shoemoneyx-first-boot.service
Wants=network-online.target

[Service]
Type=simple
User=shoemoneyx
Group=shoemoneyx
WorkingDirectory=/opt/shoemoneyx
ExecStart=/usr/bin/php artisan queue:work redis --tries=1 --timeout=3600 --sleep=2
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
