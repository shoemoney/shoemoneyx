# ops/image/marketplace.env.example
#
# t3.small   $0.0347/hr
# t3.medium  $0.0693/hr
# t3.large   $0.1387/hr
# No free trial. Annual price is 10x the monthly price.
#
# Copy this file to ops/image/marketplace.env (gitignored) and fill it in -- ops/image/release.sh
# sources it automatically. MARKETPLACE_PRODUCT_ID comes from the AWS Marketplace Management
# Portal, issued after the AMI product is created there.

# MARKETPLACE_PRODUCT_ID=
# MARKETPLACE_ROLE_ARN=arn:aws:iam::911482840889:role/shoemoneyx-marketplace-ami-ingestion
