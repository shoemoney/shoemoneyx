{
  "schema_version": 2,
  "key": "smx-bollinger-reversion",
  "author": "shoemoney",
  "meta": {
    "name": "Bollinger Band Reversion",
    "description": "Buys when price tags the lower Bollinger Band after a squeeze and sells back toward the middle band.",
    "tags": ["bollinger-bands", "mean-reversion", "volatility"],
    "timeframe": "1h",
    "assets": ["BTC-USD", "ETH-USD"]
  },
  "signals": {
    "liquid": { "all": [ { "field": "volume_h24_usd", "op": ">", "value": 300000 } ] },
    "band_stretch": { "all": [
      { "field": "ind.bb(20,2).pos", "op": "<", "value": 0.05 },
      { "field": "ind.rsi(14)", "op": "<", "value": 40 }
    ] }
  },
  "entry": {
    "side": "long",
    "when": ["liquid", "band_stretch"],
    "confirm": [ { "field": "spread_bps", "op": "<=", "value": 25, "reason": "spread too wide" } ],
    "size": { "mode": "pct_equity", "value": 4 }
  },
  "take_profit": {
    "from": "avg",
    "ladder": [
      { "at_pct": 1.2, "sell_pct_of_original": 40 },
      { "at_pct": 2.4, "sell_pct_of_original": 60 }
    ],
    "reset_on_add": true
  },
  "stop": {
    "pct_from_avg": 2.5,
    "anchor": "avg",
    "time_hours": 36,
    "rules": []
  },
  "risk": { "max_positions": 3, "daily_loss_cap_pct": 5, "leverage_cap": 1 }
}
