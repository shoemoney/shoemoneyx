{
  "schema_version": 2,
  "key": "smx-breakout-volume",
  "author": "shoemoney",
  "meta": {
    "name": "Breakout + Volume Confirmation",
    "description": "Buys when price breaks sharply higher over the last several hours and volume surges to confirm real buying interest, not a fakeout.",
    "tags": ["breakout", "volume", "momentum"],
    "timeframe": "1h",
    "assets": ["BTC-USD", "ETH-USD"]
  },
  "signals": {
    "liquid": { "all": [ { "field": "volume_h24_usd", "op": ">", "value": 500000 } ] },
    "breaking_out": { "all": [
      { "field": "price_change_h6_pct", "op": ">", "value": 5 },
      { "field": "volume_surge_h1", "op": ">", "value": 2.0 },
      { "field": "buy_sell_ratio_h1", "op": ">", "value": 1.2 }
    ] }
  },
  "entry": {
    "side": "long",
    "when": ["liquid", "breaking_out"],
    "confirm": [ { "field": "spread_bps", "op": "<=", "value": 30, "reason": "spread too wide" } ],
    "size": { "mode": "pct_equity", "value": 5 }
  },
  "take_profit": {
    "from": "avg",
    "ladder": [
      { "at_pct": 3.0, "sell_pct_of_original": 20 },
      { "at_pct": 6.0, "sell_pct_of_original": 20 }
    ],
    "runner": { "ttp": { "activate_pct": 6.0, "giveback_pct": 2.0 } },
    "reset_on_add": true
  },
  "stop": {
    "pct_from_avg": 4.0,
    "anchor": "avg",
    "time_hours": 72,
    "rules": []
  },
  "risk": { "max_positions": 3, "daily_loss_cap_pct": 5, "leverage_cap": 1 }
}
