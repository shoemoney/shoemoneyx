{
  "schema_version": 2,
  "key": "smx-rsi-mean-reversion",
  "author": "shoemoney",
  "meta": {
    "name": "RSI Mean Reversion",
    "description": "Buys a 1-hour oversold dip when RSI drops under 30 and sells back into strength on a two-step target.",
    "tags": ["mean-reversion", "rsi", "beginner"],
    "timeframe": "1h",
    "assets": ["BTC-USD", "ETH-USD"]
  },
  "signals": {
    "liquid": { "all": [ { "field": "volume_h24_usd", "op": ">", "value": 300000 } ] },
    "oversold": { "all": [ { "field": "ind.rsi(14)", "op": "<", "value": 30 } ] }
  },
  "entry": {
    "side": "long",
    "when": ["liquid", "oversold"],
    "confirm": [ { "field": "spread_bps", "op": "<=", "value": 25, "reason": "spread too wide" } ],
    "size": { "mode": "pct_equity", "value": 4 }
  },
  "take_profit": {
    "from": "avg",
    "ladder": [
      { "at_pct": 1.5, "sell_pct_of_original": 50 },
      { "at_pct": 3.0, "sell_pct_of_original": 50 }
    ],
    "reset_on_add": true
  },
  "stop": {
    "pct_from_avg": 3.0,
    "anchor": "avg",
    "time_hours": 48,
    "rules": []
  },
  "risk": { "max_positions": 3, "daily_loss_cap_pct": 5, "leverage_cap": 1 }
}
