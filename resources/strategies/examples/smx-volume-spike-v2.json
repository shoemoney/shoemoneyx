{
  "schema_version": 2,
  "key": "smx-volume-spike",
  "author": "shoemoney",
  "meta": {
    "name": "Volume Spike Scanner",
    "description": "Buys when trading volume suddenly spikes well above normal with buyers clearly in control, riding the short burst of interest.",
    "tags": ["volume", "unusual-activity", "momentum"],
    "timeframe": "15m",
    "assets": ["BTC-USD", "ETH-USD"]
  },
  "signals": {
    "liquid": { "all": [ { "field": "volume_h1_usd", "op": ">", "value": 100000 } ] },
    "spiking": { "all": [
      { "field": "volume_surge_h1", "op": ">", "value": 3.0 },
      { "field": "buy_sell_ratio_h1", "op": ">", "value": 1.5 }
    ] }
  },
  "entry": {
    "side": "long",
    "when": ["liquid", "spiking"],
    "confirm": [ { "field": "spread_bps", "op": "<=", "value": 30, "reason": "spread too wide" } ],
    "size": { "mode": "pct_equity", "value": 3 }
  },
  "take_profit": {
    "from": "avg",
    "ladder": [
      { "at_pct": 1.5, "sell_pct_of_original": 50 },
      { "at_pct": 3.0, "sell_pct_of_original": 50 }
    ],
    "reset_on_add": true
  },
  "stop": {
    "pct_from_avg": 2.0,
    "anchor": "avg",
    "time_hours": 6,
    "rules": []
  },
  "risk": { "max_positions": 3, "daily_loss_cap_pct": 5, "leverage_cap": 1 }
}
